# CommentPull — backend lock-down
# Deny ALL direct web access to everything under /backend by default
# (config.php, db.php, helpers.php, schema.sql, middleware/, cron/, migrations/ ...).
# Only the endpoint scripts in /backend/api are re-allowed by backend/api/.htaccess.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Never list directories
Options -Indexes
