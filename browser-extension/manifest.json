{
  "manifest_version": 3,
  "name": "CommentPull Lab (Experimental)",
  "version": "0.1.0",
  "description": "Test collecting visible comments from a Facebook post and import them into CommentPull.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://m.facebook.com/*",
    "https://commentpull.com/*"
  ],
  "action": {
    "default_title": "CommentPull Lab",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://m.facebook.com/*"],
      "js": ["facebook-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://commentpull.com/fb-extension-test.html"],
      "js": ["test-page-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}