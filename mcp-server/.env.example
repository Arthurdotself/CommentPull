# ── commentpull MCP Server — environment variables ───────────────────────────

# Comma-separated list of valid API keys.
# Users must send one of these in the x-api-key header.
# Leave empty (or unset) during local dev to run with no auth.
API_KEYS=key_abc123,key_def456,key_xyz789

# Port to listen on.
# Railway sets this automatically — do NOT override it in the Railway dashboard.
# Only set locally if you need a port other than 3000.
# PORT=3000
